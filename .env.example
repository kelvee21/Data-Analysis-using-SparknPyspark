# copy to .env and fill in. .env is gitignored, never commit it.
# key from themoviedb.org -> settings -> api -> "api key" (v3)
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
# optional spark settings, these are the defaults
SPARK_MASTER=local[*]
SPARK_SHUFFLE_PARTITIONS=4
SPARK_LOG_LEVEL=WARN
# windows only, the folder above bin\winutils.exe. only needed if it is not
# already a user env var (get_spark reads that one from the registry too)
# HADOOP_HOME=C:\Users\User\hadoop
